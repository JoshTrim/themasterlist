# Create a setlist.fm account and request an API key, then add it here.
SETLIST_FM_API_KEY=
# Optional: AudD music-recognition token.
AUDD_API_TOKEN=
# Optional: change this if your Google Cloud project has a different daily YouTube quota.
YOUTUBE_DAILY_QUOTA_UNITS=10000
# Country used to exclude region-blocked YouTube embeds.
YOUTUBE_REGION_CODE=AU
PORT=3000
# Public browser origin. Use HTTPS when the instance is exposed beyond a
# trusted local network. Docker requires this to match the published address.
APP_ORIGIN=http://localhost:3000
# Docker binds to loopback by default. Set 0.0.0.0 only for LAN/VPN access.
BIND_ADDRESS=127.0.0.1
# Force secure cookies when TLS terminates at a reverse proxy.
SESSION_COOKIE_SECURE=false
# Required for first-owner setup when NODE_ENV=production. Generate a long,
# random value, use it once in the setup form, then remove it after setup.
OWNER_SETUP_TOKEN=
# Per-file and total archive media limits.
MAX_MEDIA_SIZE_GB=50
MAX_MEDIA_STORAGE_GB=500
# Optional scheduled database snapshots. The same settings can be changed on
# the Maintenance page after first launch.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
