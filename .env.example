# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------
PORT=3000
# Native installs listen on this host. Docker overrides it inside the container.
HOST=127.0.0.1
# Exact origin used in the browser, with no trailing slash.
APP_ORIGIN=http://127.0.0.1:3000
# Docker host binding. Use 0.0.0.0 only on a trusted LAN or VPN.
BIND_ADDRESS=127.0.0.1
# Set true only when the browser reaches the app over HTTPS.
SESSION_COOKIE_SECURE=false
# Optional label displayed to paired instances.
INSTANCE_NAME=The Master List instance

# ---------------------------------------------------------------------------
# Required for a production/Docker first launch
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Enter once in the owner setup form; it can be removed after setup succeeds.
OWNER_SETUP_TOKEN=
# Generate with: openssl rand -base64 32
# Keep this permanently and back it up separately from /data.
CONNECTIONS_ENCRYPTION_KEY=
# Key rotation only: old key here, new key above. Remove after one successful start.
CONNECTIONS_ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# Setlists, recognition and metadata (optional)
# ---------------------------------------------------------------------------
SETLIST_FM_API_KEY=
AUDD_API_TOKEN=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# ---------------------------------------------------------------------------
# Spotify, YouTube and Apple Music playlist exports (optional)
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_STOREFRONT=au
YOUTUBE_DAILY_QUOTA_UNITS=10000
# Used to exclude region-blocked YouTube embeds.
YOUTUBE_REGION_CODE=AU

# ---------------------------------------------------------------------------
# Media processing and storage
# ---------------------------------------------------------------------------
MAX_MEDIA_SIZE_GB=50
MAX_MEDIA_STORAGE_GB=500
# Native installs normally use .venv/bin/rembg after setup:background-removal.
# REMBG_COMMAND=
REMBG_MODEL=u2net

# ---------------------------------------------------------------------------
# Scheduled SQLite snapshots
# ---------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
