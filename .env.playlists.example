# The public address your browser uses. It must match each provider's redirect URI.
APP_ORIGIN=http://localhost:3000

# Spotify: create an app at https://developer.spotify.com/dashboard
# Redirect URI: http://127.0.0.1:3000/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback

# YouTube: create OAuth 2.0 Web Application credentials in Google Cloud,
# enable YouTube Data API v3, then add this redirect URI:
# http://localhost:3000/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Music: create a MusicKit developer token (JWT) through Apple Developer.
# This is supplied to MusicKit in your local browser to authorize your subscription.
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_STOREFRONT=au
