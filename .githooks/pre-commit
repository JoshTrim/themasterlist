#!/bin/sh
set -eu

project_root=$(git rev-parse --show-toplevel)
cd "$project_root"

# Git hooks do not always inherit the interactive shell's nvm setup. Load the
# project version explicitly when nvm is installed, then fall back to PATH.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1090
  . "$NVM_DIR/nvm.sh"
  nvm use --silent >/dev/null
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: Node.js is required. Install the version in .nvmrc." >&2
  exit 1
fi

expected_node=$(cat .nvmrc)
actual_node=$(node --version | sed 's/^v//')
if [ "$actual_node" != "$expected_node" ]; then
  echo "pre-commit: expected Node $expected_node but found $actual_node." >&2
  echo "Run: nvm install && nvm use" >&2
  exit 1
fi

echo "pre-commit: checking staged changes"
git diff --cached --check

echo "pre-commit: checking JavaScript syntax"
node --check server.js
node --check public/app.js

echo "pre-commit: running listener-free tests"
npm run test:unit
